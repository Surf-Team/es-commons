// Ускоренная сборка для GitDir.
//
// Используется вместо Jenkinsfile, когда с последней успешной полной сборки файлы
// только изменялись: ничего не добавлено, не удалено и не переименовано.
// Единственное отличие от Jenkinsfile — отсутствует `clean`, поэтому содержимое
// target/ переиспользуется и Maven перекомпилирует только затронутые классы.
//
// Настоящий Jenkins этот файл не читает и всегда собирает проект полностью по Jenkinsfile.
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'mvn compile install'
            }
        }
    }
}
